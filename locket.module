#!name=Locket Gold & 30s Video
#!desc=Mở khóa trọn bộ 160 đặc quyền Locket Gold VIP, Giao diện Gold Theme và Quay video 30s (có âm thanh).
#!author=Vincent

[Script]
# Xóa cache ETag / If-None-Match để ép RevenueCat và Firebase trả về dữ liệu mới nhất
deleteHeader = type=http-request,pattern=^https:\/\/(api\.revenuecat\.com|firebaseremoteconfig\.googleapis\.com)\/.+,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/deleteHeader.js,timeout=60

# Mở khóa RevenueCat (160 VIP Entitlements, Gold Theme, Video 30s, Custom Frames)
revenuecat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^\/]+$),script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

# Mở khóa Firebase Remote Config (Cấu hình Camera 30s & Video Upload)
locketFirebase = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
