#!name=Locket Gold & 30s Video
#!desc=Mở khóa Locket Gold và mở rộng thời lượng quay video lên 30s.
#!author=Vincent

[Script]
revenuecat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^\/]+$),script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/deleteHeader.js,timeout=60

locketConfig = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.*,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com
