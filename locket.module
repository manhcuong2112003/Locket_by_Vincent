#!name=Locket Gold & 30s Video
#!desc=Mở khóa Locket Gold và mở rộng thời lượng quay video lên 30s cho Locket App Store.
#!author=Vincent

[Script]
# Xóa cache ETag ở chiều gửi đi
LocketRequest = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),requires-body=0,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js

# Sửa response Gold ở chiều trả về
LocketResponse = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js

# Sửa response Feature Gates
LocketConfig = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js

[MITM]
enable = true
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com
